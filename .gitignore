# Raw download archives
# Keep stable, renamed raw CSVs under data/raw/{domain}/, but do not commit
# duplicate one-off KOSIS download filenames.
data/raw/*/source_downloads/

# Regenerable processed intermediates
# Keep cross-domain final datasets directly under data/processed/.
data/processed/*/

