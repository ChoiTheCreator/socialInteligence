#!/usr/bin/env bash
set -euo pipefail

MAX_FILES="${HARNESS_MAX_FILES:-$(git config --default 6 --int harness.maxFiles)}"
MAX_LINES="${HARNESS_MAX_LINES:-$(git config --default 180 --int harness.maxLines)}"
MAX_AREAS="${HARNESS_MAX_AREAS:-$(git config --default 2 --int harness.maxAreas)}"

stats="$(git diff --cached --numstat)"
if [[ -z "$stats" ]]; then
  exit 0
fi

read -r added deleted files <<<"$(printf '%s\n' "$stats" | awk '
  {
    a = ($1 ~ /^[0-9]+$/) ? $1 : 0;
    d = ($2 ~ /^[0-9]+$/) ? $2 : 0;
    add += a;
    del += d;
    f += 1;
  }
  END { printf "%d %d %d", add+0, del+0, f+0 }
')"

total=$((added + deleted))
areas="$(git diff --cached --name-only | awk -F'/' '{print $1}' | sort -u | wc -l | tr -d ' ')"

if (( files > MAX_FILES )); then
  echo "[commit-harness] 변경 파일 ${files}개 > 제한 ${MAX_FILES}개"
  echo "작업 단위를 더 작게 쪼개서 커밋하세요."
  exit 1
fi

if (( total > MAX_LINES )); then
  echo "[commit-harness] 변경 라인 ${total}줄(+, - 합계) > 제한 ${MAX_LINES}줄"
  echo "큰 덩어리 커밋 금지: 논리 단위로 나눠 커밋하세요."
  exit 1
fi

if (( areas > MAX_AREAS )); then
  echo "[commit-harness] 변경 영역 ${areas}개 > 제한 ${MAX_AREAS}개"
  echo "한 커밋은 가능한 한 한 가지 작업에만 집중하세요."
  exit 1
fi
